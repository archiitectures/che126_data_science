                <td class="description-td"> <figure-callout id="10" label="Flow rate" filenames="US20130224554A1-20130829-D00000.png,US20130224554A1-20130829-D00001.png" state="{{state}}">Flow rate</figure-callout> </td>
                <td class="description-td">10 mL/min</td>
              </tr>
