                <td class="description-td">Sequential</td>
                <td class="description-td">7</td>
                <td class="description-td">115</td>
                <td class="description-td">6</td>
                <td class="description-td">115</td>
              </tr>
              <tr class="description-tr">
                <td class="description-td">Example 2</td>
              </tr>
              <tr class="description-tr">
                <td class="description-td">Working</td>
                <td class="description-td">1.0 × 10<sup>6</sup> </td>
                <td class="description-td">40</td>
                <td class="description-td">2.8 × 10<sup>5</sup> </td>
                <td class="description-td">75</td>
                <td class="description-td">Sequential</td>
                <td class="description-td">9</td>
                <td class="description-td">115</td>
                <td class="description-td">6</td>
                <td class="description-td">115</td>
              </tr>
              <tr class="description-tr">
                <td class="description-td">Example 3</td>
              </tr>
              <tr class="description-tr">
                <td class="description-td">Working</td>
                <td class="description-td">1.0 × 10<sup>6</sup> </td>
                <td class="description-td">40</td>
                <td class="description-td">2.8 × 10<sup>5</sup> </td>
                <td class="description-td">75</td>
                <td class="description-td">Sequential</td>
                <td class="description-td">7</td>
                <td class="description-td">115</td>
