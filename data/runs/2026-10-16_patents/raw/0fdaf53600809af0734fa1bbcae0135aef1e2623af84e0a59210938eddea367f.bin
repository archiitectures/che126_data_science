              <tr class="description-tr">
                <td namest="1" nameend="7" align="left" id="FOO-00002" class="description-td" colspan="7">DMAAm is N-N-dimethylacrylamide,</td>
              </tr>
              <tr class="description-tr">
                <td namest="1" nameend="7" align="left" id="FOO-00003" class="description-td" colspan="7">DMAEA is N,N-dimethylaminoethyl acrylate,</td>
