        <tr itemprop="priorityApps" itemscope repeat>
          <td>
            <span itemprop="applicationNumber">JP2010528582A</span>
            
            <a href="/patent/JP2011503247A/en">
              <span itemprop="representativePublication">JP2011503247A</span>
