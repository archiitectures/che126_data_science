        <meta itemprop="num_attr" content="0014">
      </li>
      <li itemprop="definitions" itemscope repeat>
        <span itemprop="subject">the microporous polyolefin film</span>
        <span itemprop="definition">has from 0.25% by weight to 30% by weight of a block copolymer including a polyetheresteramide.</span>
        <meta itemprop="num_attr" content="0014">
