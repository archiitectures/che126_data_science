          <li itemprop="classifications" itemscope repeat>
            <span itemprop="Code">H01M50/40</span>&mdash;<span itemprop="Description">Separators; Membranes; Diaphragms; Spacing elements inside cells</span>
            <meta itemprop="IsCPC" content="true">
