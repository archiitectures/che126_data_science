              </tr>
              <tr class="description-tr">
                <td class="description-td">Ex. 2</td>
                <td class="description-td">1.5/1.5</td>
                <td class="description-td">Synthesis</td>
                <td class="description-td">0.3</td>
                <td class="description-td">—</td>
                <td class="description-td">—</td>
                <td class="description-td">0.5/0.5</td>
                <td class="description-td">—</td>
                <td class="description-td">0.6</td>
