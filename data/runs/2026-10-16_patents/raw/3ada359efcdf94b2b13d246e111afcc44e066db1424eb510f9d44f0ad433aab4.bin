      </li>
      <li itemprop="definitions" itemscope repeat>
        <span itemprop="subject">a resin</span>
        <span itemprop="definition">was cured between glass separators.</span>
        <meta itemprop="num_attr" content="0094">
      </li>
      <li itemprop="definitions" itemscope repeat>
        <span itemprop="subject">the same resin</span>
