            <meta itemprop="IsCPC" content="true">
          </li>
          <li itemprop="classifications" itemscope repeat>
            <span itemprop="Code">Y10</span>&mdash;<span itemprop="Description">TECHNICAL SUBJECTS COVERED BY FORMER USPC</span>
            <meta itemprop="IsCPC" content="true">
          </li>
