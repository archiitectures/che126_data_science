              </tr>
              <tr class="description-tr">
                <td class="description-td"> </td>
                <td class="description-td"> <figure-callout id="1" label="ple" filenames="US20100227223A1-20100909-D00002.png" state="{{state}}">ple</figure-callout> 1</td>
                <td class="description-td"> <figure-callout id="2" label="ple" filenames="US20100227223A1-20100909-D00000.png,US20100227223A1-20100909-D00001.png" state="{{state}}">ple</figure-callout> 2</td>
                <td class="description-td"> <figure-callout id="3" label="ple" filenames="US20100227223A1-20100909-D00000.png,US20100227223A1-20100909-D00001.png" state="{{state}}">ple</figure-callout> 3</td>
                <td class="description-td"> <figure-callout id="1" label="ple" filenames="US20100227223A1-20100909-D00002.png" state="{{state}}">ple</figure-callout> 1</td>
                <td class="description-td"> <figure-callout id="2" label="ple" filenames="US20100227223A1-20100909-D00000.png,US20100227223A1-20100909-D00001.png" state="{{state}}">ple</figure-callout> 2</td>
                <td class="description-td"> <figure-callout id="3" label="ple" filenames="US20100227223A1-20100909-D00000.png,US20100227223A1-20100909-D00001.png" state="{{state}}">ple</figure-callout> 3</td>
              </tr>
              <tr class="description-tr">
                <td class="description-td"> </td>
