              </tr>
              <tr class="description-tr">
                <td class="description-td">condition</td>
                <td class="description-td">Vertical stretching temperature (° C.)</td>
                <td class="description-td">110</td>
                <td class="description-td">95</td>
                <td class="description-td">90</td>
                <td class="description-td">90</td>
