212</td> <td class="description-td">0.341</td> <td class="description-td">0.62</td> </tr> <tr class="description-tr"> <td class="description-td">Comparative</td> <td class="description-td">1.07</td> <td class="description-td">−0.67</td> <td class="description-td">3 × 10<sup>11</sup> </td> <td class="description-td">30</td> <td class="description-td">41</td> <td class="description-td">620</td> <td class="description-td">0.626</td> <td class="description-td">1.182</td> <td class="description-td">0.53</td> </tr> <tr class="description-tr"> <td class="description-td">Example 1</td> </tr> <tr class="description-tr"> <td class="description-td">Example 5</td> <td class="description-td">0.40</td> <td class="description-td">1.8</td> <td class="description-td">6 × 10<sup>12</sup> </td> <td class="description-td">25</td> <td class="description-td">60</td> <td class="description-td">110</td> <td class="description-td">0.185</td> <td class="description-td">0.291</td> <td class="description-td">0.64</td> </tr> <tr class="description-tr"> <td class="description-td">Example 6</td> <td class="description-td">0.48</td> <td class="description-td">14.1</td> <td class="description-td">5 × 10<sup>11</sup> </td> <td class="description-td">30</td> <td class="description-td">68</td> <td class="description-td">50</td> <td class="description-td">0.241</td> <td class="description-td">0.332</td> <td class="description-td">0.73</td> </tr> <tr class="description-tr"> <td class="description-td">Example 7</td> <td class="description-td">0.46</td> <td class="description-td">15.1</td> <td class="description-td">5 × 10<sup>11</sup> </td> <td class="description-td">34</td> <td class="description-td">67</td> <td class="description-td">40</td> <td class="description-td">0.238</td> <td class="description-td">0.325</td> <td class="description-td">0.73</td> </tr> <tr class="description-tr"> <td class="description-td">Example 8</td> <td class="description-td">0.42</td> <td class="description-td">3.2</td> <td