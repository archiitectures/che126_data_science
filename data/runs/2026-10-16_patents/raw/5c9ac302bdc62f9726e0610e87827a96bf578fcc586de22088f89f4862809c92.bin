                <td class="description-td">Ingredient</td>
                <td class="description-td">Parts</td>
                <td class="description-td"> <figure-callout id="70" label="Parts Parts PP" filenames="US20080269366A1-20081030-D00002.png,US20080269366A1-20081030-D00003.png" state="{{state}}">Parts</figure-callout> </td> <td class="description-td">Parts</td>
               </tr> <tr class="description-tr">
                <td namest="1" nameend="4" align="center" rowsep="1" class="description-td" colspan="4"> </td>
              </tr>
             </thead> <tbody><tr class="description-tr">
                <td class="description-td"> </td>
              </tr>
            
           </tbody></table> <figure-callout id="70" label="Parts Parts PP" filenames="US20080269366A1-20081030-D00002.png,US20080269366A1-20081030-D00003.png" state="{{state}}">
