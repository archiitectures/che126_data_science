            <tbody><tr class="description-tr">
                <td class="description-td">PP</td> </tr> </tbody></table> </figure-callout> <table align="left" colsep="0" rowsep="0" cols="4" class="description-table" width="100%"> <tbody><tr class="description-tr"> <td class="description-td"> </td>
                <td class="description-td">70</td>
