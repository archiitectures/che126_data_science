              </tr>
              <tr class="description-tr">
                <td class="description-td"> <figure-callout id="0" label="Comparative Example B" filenames="US20080269366A1-20081030-D00001.png,US20080269366A1-20081030-D00002.png" state="{{state}}">Comparative Example B<sup> </sup> </figure-callout> <sup>1</sup> </td>
                <td class="description-td">0</td>
