              </tr>
              <tr class="description-tr">
                <td class="description-td"> <figure-callout id="30" label="HDPE" filenames="US20080269366A1-20081030-D00002.png,US20080269366A1-20081030-D00005.png" state="{{state}}">HDPE</figure-callout> </td>
                <td class="description-td">30</td>
