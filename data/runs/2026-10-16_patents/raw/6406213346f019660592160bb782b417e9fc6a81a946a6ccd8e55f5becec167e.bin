        <span itemprop="definition">were 35 wt % and 65 wt %, respectively.</span>
        <meta itemprop="num_attr" content="0107">
      </li>
      <li itemprop="definitions" itemscope repeat>
        <span itemprop="subject">Phase separation</span>
