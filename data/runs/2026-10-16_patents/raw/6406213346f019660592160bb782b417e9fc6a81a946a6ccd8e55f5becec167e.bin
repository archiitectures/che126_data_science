            <tbody><tr class="description-tr">
                <td class="description-td">Polyethylene</td>
                <td class="description-td">Mw</td>
                <td class="description-td">g/mol</td>
                <td class="description-td">3.0 × 10<sup>5</sup> </td>
                <td class="description-td">3.8 × 10<sup>5</sup> </td>
                <td class="description-td">3.8 × 10<sup>5</sup> </td>
