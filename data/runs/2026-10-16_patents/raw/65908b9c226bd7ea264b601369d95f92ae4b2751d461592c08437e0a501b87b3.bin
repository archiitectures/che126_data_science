      <li itemprop="definitions" itemscope repeat>
        <span itemprop="subject">the polyethylene microporous film</span>
        <span itemprop="definition">has a thickness of 15  ⁇ m and a porosity of 60%.</span>
        <meta itemprop="num_attr" content="0071">
      </li>
      <li itemprop="definitions" itemscope repeat>
        <span itemprop="subject">the plasticizer used</span>
        <span itemprop="definition">was finally completely removed by use of an extraction solvent.</span>
        <meta itemprop="num_attr" content="0071">
      </li>
      <li itemprop="definitions" itemscope repeat>
        <span itemprop="subject">the application amount of the dispersion liquid containing the inorganic particles and the binder</span>
        <span itemprop="definition">was adjusted so as to form heat resistant insulation layers each having a thickness of 5.0  ⁇ m on both surfaces of the microporous film.</span>
        <meta itemprop="num_attr" content="0071">
      </li>
      <li itemprop="definitions" itemscope repeat>
