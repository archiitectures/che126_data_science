      <li itemprop="definitions" itemscope repeat>
        <span itemprop="subject">the alkane</span>
        <span itemprop="definition">may be C1 to C20 alkane, C1 to C10 alkane, or C1 to C6 alkane and the alkyl may be C1 to C20 alkyl, C1 to C10 alkyl, or C1 to C6 alkyl.</span>
        <meta itemprop="num_attr" content="0059">
      </li>
      <li itemprop="definitions" itemscope repeat>
        <span itemprop="subject">the salt</span>
