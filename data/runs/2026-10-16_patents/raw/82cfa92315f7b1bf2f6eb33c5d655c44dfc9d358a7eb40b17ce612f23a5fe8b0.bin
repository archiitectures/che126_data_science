        <span itemprop="subject">the microporous composite membrane of Example 1</span>
        <span itemprop="definition">has cylindrical penetrating pores having diameters of 0.4-4  ⁇ m.</span>
        <meta itemprop="num_attr" content="0105">
      </li>
      <li itemprop="definitions" itemscope repeat>
        <span itemprop="subject">fluororesin particles</span>
        <span itemprop="definition">are accumulated in the microporous composite membrane of Comparative Example 1 with no cylindrical fine pores.</span>
        <meta itemprop="num_attr" content="0105">
      </li>
      <li itemprop="definitions" itemscope repeat>
