dy><tr class="description-tr"> <td class="description-td">Poor Solvent</td> <td class="description-td">—</td> <td class="description-td">—</td> <td class="description-td">—</td> <td class="description-td">—</td> </tr> <tr class="description-tr"> <td class="description-td">μ<sup>(1) </sup>(Debye)</td> <td class="description-td">—</td> <td class="description-td">—</td> <td class="description-td">—</td> <td class="description-td">—</td> </tr> <tr class="description-tr"> <td class="description-td">Immersion Time (min.)</td> <td class="description-td">—</td> <td class="description-td">—</td> <td class="description-td">—</td> <td class="description-td">—</td> </tr>  </tbody></table> <table align="left" colsep="0" rowsep="0" cols="1" class="description-table" width="100%"> <tbody><tr class="description-tr"> <td class="description-td">Drying Conditions</td> </tr>  </tbody></table> <table align="left" colsep="0" rowsep="0" cols="5" class="description-table" width="100%"> <tbody><tr class="description-tr"> <td class="description-td">Temperature (° C.)</td> <td class="description-td">60</td> <td class="description-td">60</td> <td class="description-td">60</td> <td class="description-td">60</td> </tr> <tr class="description-tr"> <td class="description-td">Time (min.)</td> <td class="description-td">2</td> <td class="description-td">2</td> <td class="description-td">2</td> <td class="description-td">2</td> </tr>  </tbody></table> <table align="left" colsep="0" rowsep="0" cols="1" class="description-table" width="100%"> <tbody><tr class="description-tr"> <td class="description-td">Properties of Microporous Composite Membrane</td> </tr>  </tbody></table> <table align="left" colsep="0" rowsep="0" cols="5" class="description-table" width="100%"> <tbody><tr class="description-tr"> <td class="description-td">State of</td> <td class="description-td">Having</td> <td class="description-td">Having</td> <td class="description-td">Having cylindrical</td> <td class="description-td">Having</t