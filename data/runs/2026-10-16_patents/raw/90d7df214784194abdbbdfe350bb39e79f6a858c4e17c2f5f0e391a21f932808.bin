 <td class="description-td">° C.</td> <td class="description-td">120</td> <td class="description-td">120</td> <td class="description-td">118</td> <td class="description-td">117</td> <td class="description-td">120</td> <td class="description-td">120</td> <td class="description-td">120</td> </tr> <tr class="description-tr"> <td class="description-td"> </td> <td class="description-td">Crystalline molten</td> <td class="description-td">%</td> <td class="description-td">20</td> <td class="description-td">20</td> <td class="description-td">20</td> <td class="description-td">10</td> <td class="description-td">20</td> <td class="description-td">20</td> <td class="description-td">20</td> </tr> <tr class="description-tr"> <td class="description-td"> </td> <td class="description-td">Time</td> <td class="description-td">sec</td> <td class="description-td">15</td> <td class="description-td">15</td> <td class="description-td">18</td> <td class="description-td">20</td> <td class="description-td">15</td> <td class="description-td">15</td> <td class="description-td">15</td> </tr>  </tbody></table> <table align="left" colsep="0" rowsep="0" cols="9" class="description-table" width="100%"> <tbody><tr class="description-tr"> <td class="description-td">Number of gels in sheet</td> <td class="description-td">#/100 cm<sup>2</sup> </td> <td class="description-td">2</td> <td class="description-td">6</td> <td class="description-td">7</td> <td class="description-td">3</td> <td class="description-td">2</td> <td class="description-td">3</td> <td class="description-td">3</td> </tr> <tr class="description-tr"> <td class="description-td">Film thickness</td> <td class="description-td">μm</td> <td class="description-td">16</td> <td class="description-td">16</td> <td class="description-td">17</td> <td class="description-td">16</td> <td class="description-td">16</td> <td class="description-td">16</td> <td class="description-td">16</td> </tr> <tr class="description-tr"> <td class="description-td">Puncture Strength</td> <td class="description-td">N/μm</td> <td class="description-td">0.18</td> <td class="description-td">0.24</td> <td class="description-td">0.18</td> <td class="description-td">0.28</td> <td class="description-td">0.22</td> <td class="description-td">0.23</td> <td class="description-td">0.22</td> </tr> <tr class="description-tr"> <td class="description-td">Air Permeability</td> <td class="description-td">10<sup>−5 </sup>Darcy</td> <td class="description-td">3.8</td> <td class="description-td">2.8</td> <td class="description-td">5.0</td> <td class="description-td">2.1</td> <td class="description-td">2.8</td> <td class="description-td">2.7</td> <td class="description-td">2.3</td> </tr> <tr class="description-tr"> <td class="description-td">Puncture*Permeability</td> <td class="description-td">10<sup>−5 </sup>Darcy, N/μm</td> <td class="description-td">0.68</td> <td class="description-td">0.67</td> <td class="description-td">0.90</td> <td class="description-td">0.59</td> <td class="description-td">0.62</td> <td class="description-td">0.62</td> <td class="description-td">0.51</td> </tr>  </tbody></table> <table align="left" colsep="0" rowsep="0" cols="10" class="description-table" width="100%"> <tbody><tr class="description-tr"> <td class="description-td">Shrinkage</td> <td class="description-td">MD</td> <td class="description-td">%</td> <td class="description-td">3.5</td> <td class="description-td">3.5</td> <td class="description-td">4.3</td> <td class="description-td">3.7</td> <td class="description-td">3.2</td> <td class="description-td">3.3</td> <td class="description-td">3.8</td> </tr> <tr class="description-tr"> <td class="description-td"> </td> <td class="description-td">TD</td> <td class="description-td"> </td> <td class="description-td">1.5</td> <td class="description-td">1.8</td> <td class="description-td">2.5</td> <td class="description-td">3.4</td> <td class="description-td">1.6</td> <td class="description-td">1.7</td> <td class="description-td">1.9</td> </tr> <tr class="description-tr"> <td namest="1" nameend="10" align="center" rowsep="1" class="description-td" colspan="10"> </td> </tr>  </tbody></table> </patent-tables> </tables>
</div>
    </li> <li> <para-num num="[0094]"> </para-num> <div id="p-0095" num="0094" class="description-line">
      <tables id="TABLE-US-00002" num="2">
        <patent-tables frame="none" colsep="0" rowsep="0" pgwide="1">
          <table align="left" colsep="0" rowsep="0" cols="1" class="description-table" width="100%">
            <thead>
              <tr class="description-tr">
                <td namest="1" nameend="1" align="center" class="description-td" colspan="1">TABLE 2</td>
              </tr>
            </thead>
            
              <tbody><tr class="description-tr">
                <td class="description-td"> </td>
              </tr>
              <tr class="description-tr">
                <td namest="1" nameend="1" align="center" rowsep="1" class="description-td" colspan="1"> </td>
              </tr>
              <tr class="description-tr">
                <td class="description-td">Comparative Examples</td>
