        <meta itemprop="num_attr" content="0069">
      </li>
      <li itemprop="definitions" itemscope repeat>
        <span itemprop="subject">the temperature for heat-setting</span>
        <span itemprop="definition">was set to be 118° C. and the time for 18 seconds in order to adjust the degree of melting of crystals to 20 weight %.</span>
        <meta itemprop="num_attr" content="0070">
      </li>
      <li itemprop="definitions" itemscope repeat>
