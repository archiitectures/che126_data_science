        <tr itemprop="appsClaimingPriority" itemscope repeat>
          <td>
            <span itemprop="applicationNumber">US10/973,392</span>
            <a href="/patent/US8075818B2/en">
              <span itemprop="representativePublication">US8075818B2</span>
                (<span itemprop="primaryLanguage">en</span>)
