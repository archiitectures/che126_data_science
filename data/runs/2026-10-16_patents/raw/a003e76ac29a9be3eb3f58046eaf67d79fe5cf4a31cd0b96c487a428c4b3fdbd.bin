      <li itemprop="landscapes" itemscope repeat>
        <span itemprop="name">Polymers &amp; Plastics</span>
        (<span itemprop="type">AREA</span>)
      </li>
      <li itemprop="landscapes" itemscope repeat>
        <span itemprop="name">Organic Chemistry</span>
        (<span itemprop="type">AREA</span>)
