          <li itemprop="classifications" itemscope repeat>
            <span itemprop="Code">H01M10/00</span>&mdash;<span itemprop="Description">Secondary cells; Manufacture thereof</span>
            <meta itemprop="IsCPC" content="true">
          </li>
          <li itemprop="classifications" itemscope repeat>
            <span itemprop="Code">H01M10/05</span>&mdash;<span itemprop="Description">Accumulators with non-aqueous electrolyte</span>
            <meta itemprop="IsCPC" content="true">
          </li>
          <li itemprop="classifications" itemscope repeat>
            <span itemprop="Code">H01M10/052</span>&mdash;<span itemprop="Description">Li-accumulators</span>
            <meta itemprop="IsCPC" content="true">
          </li>
          <li itemprop="classifications" itemscope repeat>
            <span itemprop="Code">H01M10/0525</span>&mdash;<span itemprop="Description">Rocking-chair batteries, i.e. batteries with lithium insertion or intercalation in both electrodes; Lithium-ion batteries</span>
            <meta itemprop="Leaf" content="true"><meta itemprop="Additional" content="true"><meta itemprop="IsCPC" content="true">
          </li>
        </ul>
