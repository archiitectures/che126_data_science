  <section itemprop="claims" itemscope>
    <h2>Claims (<span itemprop="count">2</span>)</h2>
    
    <div itemprop="content" html><div mxw-id="PCLM5558261" lang="EN" load-source="patent-office" class="claims">
    <claim-statement>What is claimed:</claim-statement>
    <div class="claim"> <div num="1" class="claim">
      <div class="claim-text">1. A battery separator comprising a microporous polyolefin membrane having a thickness of about 0.33 mils to about 0.5 mils.</div>
    </div>
    </div> <div class="claim-dependent"> <div num="2" class="claim">
      <div class="claim-text">2. A battery comprising the separator of claim 1.</div>
    </div>
  </div> </div>
