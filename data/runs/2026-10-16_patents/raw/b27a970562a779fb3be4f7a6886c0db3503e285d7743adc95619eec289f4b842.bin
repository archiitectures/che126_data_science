                <td class="description-td"> </td>
              </tr>
              <tr class="description-tr">
                <td class="description-td">Mw<sup>(1)</sup>/(Mw/Mn)<sup>(2)</sup>/wt. %</td>
                <td class="description-td">1.5 × 10<sup>6</sup>/8/5  </td>
                <td class="description-td">2.0 × 10<sup>6</sup>/8/5  </td>
                <td class="description-td">2.0 × 10<sup>6</sup>/8/5  </td>
              </tr>
              <tr class="description-tr">
                <td class="description-td">HDPE</td>
              </tr>
              <tr class="description-tr">
                <td class="description-td">Mw<sup>(1)</sup>/(Mw/Mn)<sup>(2)</sup>/wt. %</td>
                <td class="description-td">3.0 × 10<sup>5</sup>/8.6/95</td>
                <td class="description-td">3.0 × 10<sup>5</sup>/8.6/95</td>
                <td class="description-td">3.0 × 10<sup>5</sup>/8.6/95</td>
              </tr>
              <tr class="description-tr">
