            <tbody><tr class="description-tr">
                <td class="description-td">PP Concentration (% by mass)</td>
                <td class="description-td">50</td>
                <td class="description-td">50</td>
                <td class="description-td">50</td>
              </tr>
              <tr class="description-tr">
                <td class="description-td">PE Composition Concentration (% by mass)</td>
                <td class="description-td">30</td>
                <td class="description-td">30</td>
                <td class="description-td">30</td>
              </tr>
              <tr class="description-tr">
                <td class="description-td">Extrudate</td>
              </tr>
              <tr class="description-tr">
                <td class="description-td">Layer Structure<sup>(2)</sup> </td>
                <td class="description-td">PP/PE</td>
                <td class="description-td">PP/PE</td>
