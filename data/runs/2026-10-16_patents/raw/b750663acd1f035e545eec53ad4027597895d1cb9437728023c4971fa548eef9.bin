        <meta itemprop="num_attr" content="0132">
      </li>
      <li itemprop="definitions" itemscope repeat>
        <span itemprop="subject">the porous layer</span>
        <span itemprop="definition">was removed from the laminated porous film ( 2 ) by a method similar to the method used in Example 1.</span>
        <meta itemprop="num_attr" content="0133">
      </li>
      <li itemprop="definitions" itemscope repeat>
        <span itemprop="subject">Example 2</span>
