        <meta itemprop="num_attr" content="0066">
      </li>
      <li itemprop="definitions" itemscope repeat>
        <span itemprop="subject">aqueous polymeric binder</span>
        <span itemprop="definition">comprises at least two of polyvinyl alcohol (PVOH), polyvinyl acetate (PVAc), polyacrylic acid salt, polyacrylonitrile, polyacrylamide or poly(sodium acrylate-acrylamide-acrylonitrile) copolymer or copolymers thereof.</span>
