            <tbody><tr class="description-tr">
                <td class="description-td"> </td>
                <td class="description-td">Heat-Resistant Resin Type/Mw<sup>(1)</sup>/wt %</td>
                <td class="description-td">PBT/3.8 × 10<sup>4</sup>/20</td>
                <td class="description-td">PBT/3.8 × 10<sup>4</sup>/20</td>
                <td class="description-td">PBT/3.8 × 10<sup>4</sup>/20</td>
              </tr>
            
          </tbody></table>
          <table align="left" colsep="0" rowsep="0" cols="6" class="description-table" width="100%">
            <tbody><tr class="description-tr">
                <td class="description-td"> </td>
                <td class="description-td">Filler</td>
                <td class="description-td">Type/wt %<sup>(2)</sup> </td>
