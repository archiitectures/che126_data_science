  <section>
    <h2>Classifications</h2>
    <ul>
      <li>
        <ul itemprop="classifications" itemscope repeat>
          <li itemprop="classifications" itemscope repeat>
            <span itemprop="Code">D</span>&mdash;<span itemprop="Description">TEXTILES; PAPER</span>
            <meta itemprop="IsCPC" content="true">
          </li>
          <li itemprop="classifications" itemscope repeat>
            <span itemprop="Code">D01</span>&mdash;<span itemprop="Description">NATURAL OR MAN-MADE THREADS OR FIBRES; SPINNING</span>
            <meta itemprop="IsCPC" content="true">
          </li>
          <li itemprop="classifications" itemscope repeat>
            <span itemprop="Code">D01D</span>&mdash;<span itemprop="Description">MECHANICAL METHODS OR APPARATUS IN THE MANUFACTURE OF ARTIFICIAL FILAMENTS, THREADS, FIBRES, BRISTLES OR RIBBONS</span>
            <meta itemprop="IsCPC" content="true">
