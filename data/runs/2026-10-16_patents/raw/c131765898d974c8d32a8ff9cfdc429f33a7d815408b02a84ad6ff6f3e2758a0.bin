                <td class="description-td">100</td>
                <td class="description-td">20</td>
                <td class="description-td">23</td>
                <td class="description-td">55%</td>
                <td class="description-td">165 ± 94 </td>
              </tr>
              <tr class="description-tr">
                <td class="description-td"> </td>
                <td class="description-td">50/50</td>
              </tr>
              <tr class="description-tr">
                <td class="description-td">Ex. 12C</td>
                <td class="description-td">4-chloro-2-methyl-</td>
                <td class="description-td">10%</td>
                <td class="description-td">1</td>
                <td class="description-td">30</td>
                <td class="description-td">33</td>
                <td class="description-td">35%</td>
                <td class="description-td">197 ± 57 </td>
              </tr>
              <tr class="description-tr">
