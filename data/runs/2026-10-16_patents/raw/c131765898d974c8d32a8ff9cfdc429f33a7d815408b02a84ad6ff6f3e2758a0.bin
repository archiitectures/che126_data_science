      <li itemprop="definitions" itemscope repeat>
        <span itemprop="subject">a solution</span>
        <span itemprop="definition">comprised of about 25 wt. % ULTEM 1010 dissolved in NMP, with a solution viscosity of about 6,200 cP was spun through an orifice diameter of 159  ⁇ m (30G) at a spinneret speed of 12,000 RPM.</span>
        <meta itemprop="num_attr" content="0210">
      </li>
      <li itemprop="definitions" itemscope repeat>
        <span itemprop="subject">This example</span>
        <span itemprop="definition">resulted in fiber diameters between about 379 nm and about 4.95  ⁇ m, with an average diameter of about 1.37  ⁇ m.</span>
        <meta itemprop="num_attr" content="0210">
      </li>
      <li itemprop="definitions" itemscope repeat>
        <span itemprop="subject">FIG. 16A</span>
        <span itemprop="definition">illustrates a representation of the example&#39;s fiber morphology.</span>
        <meta itemprop="num_attr" content="0210">
      </li>
      <li itemprop="definitions" itemscope repeat>
        <span itemprop="subject">FIG. 16B</span>
        <span itemprop="definition">illustrates a histogram of the fiber diameter distribution.</span>
        <meta itemprop="num_attr" content="0210">
      </li>
      <li itemprop="definitions" itemscope repeat>
        <span itemprop="subject">Table C</span>
        <span itemprop="definition">illustrates exemplary results of fiber spinning a polymer solution comprising PPO 6130 (Polyphenylene oxide (SABIC)) dissolved in chloroform.</span>
        <meta itemprop="num_attr" content="0211">
      </li>
      <li itemprop="definitions" itemscope repeat>
        <span itemprop="subject">PPO 6130</span>
        <span itemprop="definition">Polyphenylene oxide (SABIC)</span>
        <meta itemprop="num_attr" content="0211">
      </li>
