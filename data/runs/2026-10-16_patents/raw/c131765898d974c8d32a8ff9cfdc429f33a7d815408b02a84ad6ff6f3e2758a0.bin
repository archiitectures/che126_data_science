                <td class="description-td">Ex. <figure-callout id="1" label="13C" filenames="US09577235-20170221-D00005.png,US09577235-20170221-D00009.png" state="{{state}}"> <figure-callout id="1" label="13C" filenames="US09577235-20170221-D00005.png,US09577235-20170221-D00009.png" state="{{state}}"> <figure-callout id="2" label="13C" filenames="US09577235-20170221-D00007.png,US09577235-20170221-D00044.png" state="{{state}}">13C</figure-callout> </figure-callout> </figure-callout> </td>
                <td class="description-td">1,1,2,2-</td>
