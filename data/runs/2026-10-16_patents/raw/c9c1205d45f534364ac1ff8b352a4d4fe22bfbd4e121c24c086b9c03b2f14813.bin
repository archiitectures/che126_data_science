          <li itemprop="classifications" itemscope repeat>
            <span itemprop="Code">H01M50/489</span>&mdash;<span itemprop="Description">Separators, membranes, diaphragms or spacing elements inside the cells, characterised by their physical properties, e.g. swelling degree, hydrophilicity or shut down properties</span>
            <meta itemprop="IsCPC" content="true">
