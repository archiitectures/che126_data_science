            <meta itemprop="IsCPC" content="true">
          </li>
          <li itemprop="classifications" itemscope repeat>
            <span itemprop="Code">H01M50/409</span>&mdash;<span itemprop="Description">Separators, membranes or diaphragms characterised by the material</span>
            <meta itemprop="IsCPC" content="true">
          </li>
          <li itemprop="classifications" itemscope repeat>
            <span itemprop="Code">H01M50/449</span>&mdash;<span itemprop="Description">Separators, membranes or diaphragms characterised by the material having a layered structure</span>
            <meta itemprop="Leaf" content="true"><meta itemprop="IsCPC" content="true">
          </li>
