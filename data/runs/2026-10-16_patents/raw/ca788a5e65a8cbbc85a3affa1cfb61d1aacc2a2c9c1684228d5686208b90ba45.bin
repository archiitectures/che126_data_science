        <meta itemprop="num_attr" content="0105">
      </li>
      <li itemprop="definitions" itemscope repeat>
        <span itemprop="subject">Example 8</span>
        <span itemprop="definition">20 2 40 0.7 360 5.1 0.8  ⁇  76</span>
        <meta itemprop="num_attr" content="0105">
      </li>
      <li itemprop="definitions" itemscope repeat>
        <span itemprop="subject">Example 9</span>
        <span itemprop="definition">20 2</span>
        <meta itemprop="num_attr" content="0105">
      </li>
      <li itemprop="definitions" itemscope repeat>
        <span itemprop="subject">the polyolefin microporous membranes of the present invention</span>
        <span itemprop="definition">can be used as precision filter membranes, separators for batteries, separators for capacitors, materials for fuel cell, and the like, and are particularly suitable as separators for lithium ion batteries.</span>
