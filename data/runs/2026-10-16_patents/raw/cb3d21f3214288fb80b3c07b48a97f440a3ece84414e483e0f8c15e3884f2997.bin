      </li>
      <li itemprop="definitions" itemscope repeat>
        <span itemprop="subject">step 2</span>
        <span itemprop="definition">extruding the mixture into a strip by an extruder</span>
        <meta itemprop="num_attr" content="0062">
      </li>
      <li itemprop="definitions" itemscope repeat>
        <span itemprop="subject">step 3</span>
        <span itemprop="definition">extracting the strip with an organic solvent</span>
        <meta itemprop="num_attr" content="0063">
      </li>
      <li itemprop="definitions" itemscope repeat>
