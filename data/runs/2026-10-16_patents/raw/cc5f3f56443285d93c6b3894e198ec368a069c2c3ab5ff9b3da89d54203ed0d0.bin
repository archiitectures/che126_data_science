        <span itemprop="definition">was 105° C., 120° C., and 130° C., respectively.</span>
        <meta itemprop="num_attr" content="0350">
      </li>
      <li itemprop="definitions" itemscope repeat>
        <span itemprop="subject">the results</span>
        <span itemprop="definition">are shown in Table 9.</span>
        <meta itemprop="num_attr" content="0350">
      </li>
