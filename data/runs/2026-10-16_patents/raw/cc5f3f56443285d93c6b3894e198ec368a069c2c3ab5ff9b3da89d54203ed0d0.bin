        <span itemprop="definition">is from 100 nm to 2000 nm</span>
        <meta itemprop="num_attr" content="0088">
      </li>
      <li itemprop="definitions" itemscope repeat>
        <span itemprop="subject">MFR</span>
        <span itemprop="definition">Melt Flow Rate</span>
        <meta itemprop="num_attr" content="0089">
