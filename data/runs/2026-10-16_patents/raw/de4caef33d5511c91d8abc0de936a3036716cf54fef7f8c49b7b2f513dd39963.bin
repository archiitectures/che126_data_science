      </li>
      <li itemprop="definitions" itemscope repeat>
        <span itemprop="subject">the polypropylene indicated in Table 9</span>
        <span itemprop="definition">was melted in a 2.5-inch extruder at 220° C.</span>
        <meta itemprop="num_attr" content="0323">
      </li>
