  <section itemprop="claims" itemscope>
    <h2>Claims (<span itemprop="count">3</span>)</h2>
    
    <div itemprop="content" html><div mxw-id="PCLM58793868" lang="EN" load-source="patent-office" class="claims">
    <claim-statement>What is claimed is:</claim-statement>
    <div class="claim"> <div num="1" class="claim">
      <div class="claim-text">1. A polyethylene microporous membrane consisting of polyethylene having a weight average molecular weight of at least 5×10<sup>5</sup>, and having a thickness of at most 10 μm, a breaking strength of at least 200 kg/cm<sup>2</sup> and a porosity of at least 30%.</div>
    </div>
    </div> <div class="claim-dependent"> <div num="2" class="claim">
      <div class="claim-text">2. The polyethylene microporous membrane of claim 1, wherein the thickness is 0.1 to 10 μm, the breaking strength is at least 200 kg/cm<sup>2</sup> and the porosity is 30 to 95%.</div>
    </div>
    </div> <div class="claim-dependent"> <div num="3" class="claim">
      <div class="claim-text">3. The polyethylene microporous membrane of claim 1, wherein the weight average molecular weight is 1×10<sup>6</sup> to 10×10<sup>6</sup>.</div>
    </div>
  </div> </div>
  </div>
  </section>

