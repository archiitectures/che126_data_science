                      </mfrac>
                      <mo>×</mo>
                      <mn>100</mn>
                    </mrow>
                  </mrow>
                </mrow>
              </mtd>
              <mtd>
                <mrow>
                  <mo>[</mo>
                  <mrow>
                    <mi>Expression</mi>
                    <mo>⁢</mo>
