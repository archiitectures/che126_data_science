        <meta itemprop="num_attr" content="0079">
      </li>
      <li itemprop="definitions" itemscope repeat>
        <span itemprop="subject">the said improved and modified microporous polyolefin separator membrane</span>
        <span itemprop="definition">has a thickness less than 25  ⁇ m</span>
        <meta itemprop="num_attr" content="0079">
      </li>
      <li itemprop="definitions" itemscope repeat>
        <span itemprop="subject">the said improved and modified microporous polyolefin separator membrane</span>
        <span itemprop="definition">has pores with a non-round, trapezoid shape, and/or a novel, improved or modified or modified</span>
