      <li itemprop="definitions" itemscope repeat>
        <span itemprop="subject">the cell</span>
        <span itemprop="definition">was tested at room temperature, and voltage range was set to 2.5-4.2v.</span>
        <meta itemprop="num_attr" content="0323">
      </li>
      <li itemprop="definitions" itemscope repeat>
        <span itemprop="subject">Experiment D</span>
        <span itemprop="definition">Two coin cells of size 2035 were made having a PE/PP/PE multilayer separator (Celgard 2325) 0.025 mm thick.</span>
        <meta itemprop="num_attr" content="0324">
      </li>
      <li itemprop="definitions" itemscope repeat>
        <span itemprop="subject">the electrolyte used</span>
        <span itemprop="definition">was Merck LP 50(1 M LiPF 6 in EC-EMC 1:1).</span>
        <meta itemprop="num_attr" content="0324">
      </li>
      <li itemprop="definitions" itemscope repeat>
        <span itemprop="subject">a LiFePO 4 cathode</span>
        <span itemprop="definition">was used and a Li anode was used.</span>
        <meta itemprop="num_attr" content="0324">
      </li>
      <li itemprop="definitions" itemscope repeat>
        <span itemprop="subject">a Ni mesh(333)</span>
        <span itemprop="definition">was positioned between the LiFePO 4 cathode and the separator.</span>
        <meta itemprop="num_attr" content="0324">
      </li>
      <li itemprop="definitions" itemscope repeat>
        <span itemprop="subject">FIGS. 42 and 43</span>
        <span itemprop="definition">show the cycling data, voltage vs time and current vs time, of the cell.</span>
        <meta itemprop="num_attr" content="0325">
      </li>
      <li itemprop="definitions" itemscope repeat>
        <span itemprop="subject">the cell</span>
        <span itemprop="definition">was tested at room temperature, and voltage range was set to 2.5-4.2v.</span>
        <meta itemprop="num_attr" content="0325">
      </li>
      <li itemprop="definitions" itemscope repeat>
        <span itemprop="subject">ranges</span>
        <span itemprop="definition">specifically include the values provided as endpoint values of the range.</span>
        <meta itemprop="num_attr" content="0334">
      </li>
      <li itemprop="definitions" itemscope repeat>
        <span itemprop="subject">ranges</span>
