        <span itemprop="subject">anode</span>
        <span itemprop="definition">such as silicon</span>
        <meta itemprop="num_attr" content="0233">
      </li>
      <li itemprop="definitions" itemscope repeat>
        <span itemprop="subject">one or more porous layers</span>
        <span itemprop="definition">such as 80% porous PE</span>
        <meta itemprop="num_attr" content="0233">
      </li>
      <li itemprop="definitions" itemscope repeat>
        <span itemprop="subject">a mechanically, chemically and/or heat resistant layer</span>
        <span itemprop="definition">that is ionically conductive but electronically insulating, such as a perforated Kapton layer</span>
        <meta itemprop="num_attr" content="0233">
      </li>
