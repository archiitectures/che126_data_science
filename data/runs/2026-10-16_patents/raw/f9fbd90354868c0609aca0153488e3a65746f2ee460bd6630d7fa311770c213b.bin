      <li itemprop="definitions" itemscope repeat>
        <span itemprop="subject">the first electronically and ionically conductive layer</span>
        <span itemprop="definition">is provided in physical contact and/or electronic contact with the separator.</span>
        <meta itemprop="num_attr" content="0095">
      </li>
      <li itemprop="definitions" itemscope repeat>
        <span itemprop="subject">the first electronically and ionically conductive layer</span>
