        <span itemprop="definition">such as 80% porous PE</span>
        <meta itemprop="num_attr" content="0232">
      </li>
      <li itemprop="definitions" itemscope repeat>
        <span itemprop="subject">at least mechanically, chemically, and/or heat resistant layer</span>
        <span itemprop="definition">that is electronically and ionically conductive, such as a perforated metal, positioned proximate to the anode and a cathode</span>
        <meta itemprop="num_attr" content="0232">
      </li>
