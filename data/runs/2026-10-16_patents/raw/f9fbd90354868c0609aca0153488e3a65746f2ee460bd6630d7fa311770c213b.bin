        <meta itemprop="num_attr" content="0229">
      </li>
      <li itemprop="definitions" itemscope repeat>
        <span itemprop="subject">a cathode</span>
        <span itemprop="definition">such as a LiFePO 4 or LiCoO 2</span>
        <meta itemprop="num_attr" content="0229">
